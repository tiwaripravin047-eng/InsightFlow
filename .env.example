# InsightFlow — Unified Environment Configuration Template
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database & Cache (Track A & C)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_os
REDIS_URL=redis://localhost:6379/0

# ML Model Configuration (Track A)
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Keys & Provider (Track C / Grounded AI Layer)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Storage Backend Configuration (Track C)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/local
S3_BUCKET_NAME=feedback-intelligence-uploads
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Ingestion Limits
UPLOAD_MAX_MB=25
UPLOAD_MAX_ROWS=100000

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=hackathon-dev-secret-key-32-chars-long

# Parallel Dev Stub Policy
USE_ANALYTICS_STUB=false

# Frontend Configuration (Track B)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
