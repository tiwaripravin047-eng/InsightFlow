# Feedback Intelligence OS — Environment Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_os
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Track C / Ask Feedback)
LLM_PROVIDER=local
LLM_API_KEY=
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1

# ML Model Configuration (Track A)
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Ingestion Limits
UPLOAD_MAX_MB=25
UPLOAD_MAX_ROWS=100000

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=hackathon-dev-secret-key-32-chars-long
